# Supabase (required for authentication, dashboards, files, and live data)
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Required for complete signup and trusted server operations. This key bypasses
# Row Level Security; keep it server-only and never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (required in production; used for auth links and QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional email delivery. Configure both values or leave both blank.
RESEND_API_KEY=
EMAIL_FROM=

# Optional SMS delivery. Configure all three values or leave all blank.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# Optional WhatsApp delivery. Configure all three values or leave all blank.
# Set the API version to one currently supported by your Meta app (for example, vXX.X).
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_API_VERSION=

# Reserved for a future ADCB merchant API integration. The current platform
# uses payment links that an administrator attaches to each payment record.
ADCB_PACE_PAY_BASE_URL=
ADCB_PACE_PAY_API_KEY=

# Safety confirmation for `npm run seed:demo` against a non-local Supabase
# project. Leave blank for local Supabase. Never point the demo seed at production.
SEED_DEMO_CONFIRM_PROJECT_REF=
