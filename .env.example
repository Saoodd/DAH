# ── Supabase (required) ─────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, bypasses Row Level Security.
# NEVER prefix this with NEXT_PUBLIC_, never commit it, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────────
# Used to build email confirmation / password reset redirect links.
# Local dev: http://localhost:3000
# Production: your real Vercel/production URL (must also be added to
# Supabase Auth → URL Configuration → Redirect URLs, see README).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (Phase 5 — notifications) ────────────────────────────────────
# Not required for Phase 1-4. Leave blank in development; notification
# sending falls back to a logged/dev-only stub until these are set.
RESEND_API_KEY=
EMAIL_FROM="Dar Al Hay Events <events@daralhay.ae>"

# ── SMS (Phase 5 — notifications) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# ── WhatsApp (Phase 5 — notifications) ─────────────────────────────────
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PHONE_ID=

# ── ADCB Pace Pay (Phase 4 — payments) ─────────────────────────────────
# No public API is integrated yet — these are placeholders for when Dar Al
# Hay receives ADCB's merchant API credentials. Until then, admins attach
# payment links manually from the admin dashboard.
ADCB_PACE_PAY_BASE_URL=
ADCB_PACE_PAY_API_KEY=
